{$WEUTUBE_API_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    reverse_proxy api:8080
}

{$WEUTUBE_WEB_DOMAIN}, www.{$WEUTUBE_WEB_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        # Embedded YouTube players require a valid origin for client identity.
        # Suppressing Referer entirely causes embedded-player error 153.
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    reverse_proxy web:80
}
