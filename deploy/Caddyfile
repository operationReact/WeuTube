{$WEUTUBE_API_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    reverse_proxy api:8080
}

{$WEUTUBE_WEB_DOMAIN}, www.{$WEUTUBE_WEB_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    reverse_proxy web:80
}
